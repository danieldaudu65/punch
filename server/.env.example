# Copy this file to .env and fill in the values.

NODE_ENV=development
PORT=4000

# MongoDB Atlas connection string (free M0 cluster is enough).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/punch-nextgen

# Long random string. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Where the React app runs. Used for CORS.
CLIENT_ORIGIN=http://localhost:5173

# Number of proxies in front of the API. 1 locally; 2 on Render behind the Netlify proxy.
TRUST_PROXY_HOPS=1
